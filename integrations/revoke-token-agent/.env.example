# --- Azure authentication (only for LIVE scans with the full agent) ---
# DefaultAzureCredential reads these automatically. Easiest alternative: `az login`.
# App registration needs admin-consented Microsoft Graph application
# permissions: RoleManagement.Read.Directory + Directory.Read.All
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=...

# Not required for the offline demo (revoke_token_agent_demo.py).
